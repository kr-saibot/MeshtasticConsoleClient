<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>Meshtastic.Client</RootNamespace>
    <!-- Build with Configuration=Linux for Mono/Linux deployments. -->
    <Configurations>Debug;Release;Linux</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <PackageReference Include="Google.Protobuf" Version="3.25.8" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.8" />
    <PackageReference Include="Grpc.Tools" Version="2.62.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Linux'">
    <!-- Linux uses the distribution supplied libsqlite3.so. -->
    <PackageReference Include="SQLitePCLRaw.provider.sqlite3" Version="2.1.6" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Linux'">
    <!-- Windows retains the application-local SQLite implementation. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.6" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Linux'">
    <DefineConstants>$(DefineConstants);SYSTEM_SQLITE</DefineConstants>
    <OutputPath>bin\Linux\</OutputPath>
    <IntermediateOutputPath>obj\Linux\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Protobuf Include="..\..\proto\nanopb.proto" ProtoRoot="..\..\proto" GrpcServices="None" />
    <Protobuf Include="..\..\proto\meshtastic\*.proto" ProtoRoot="..\..\proto" GrpcServices="None" />
  </ItemGroup>
</Project>
