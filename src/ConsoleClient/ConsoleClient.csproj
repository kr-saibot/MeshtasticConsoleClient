<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.2.1</Version>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <FileVersion>1.2.1.0</FileVersion>
    <Configurations>Debug;Release;Linux</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Linux'">
    <OutputPath>bin\Linux\</OutputPath>
    <IntermediateOutputPath>obj\Linux\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <PackageReference Include="Terminal.Gui" Version="1.18.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Meshtastic.Client\Meshtastic.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="logo\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="map\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="emoji-replacements.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="emoji-blocks-full.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="emoji-blocks-12line-full.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE-Meshtastic-Protobufs.txt" Link="LICENSE-Meshtastic-Protobufs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildDateUtc" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm:ss'))" />
  </ItemGroup>
</Project>
